{
  // Static site on Cloudflare Workers. Only ./dist is uploaded; deploy.sh
  // builds it from the public files, so notes and tools never go live.
  "name": "harishsuresh-dev",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "harishsuresh.dev", "custom_domain": true }]
}
