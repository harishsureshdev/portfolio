{
  // Static site on Cloudflare Workers. Only ./dist is uploaded; build.sh
  // fills it from the public files, so notes and tools never go live.
  "name": "harishsuresh-dev",
  "main": "worker.js",
  "compatibility_date": "2026-09-27",
  "build": { "command": "sh build.sh" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // the worker must see www requests before a matching file is served
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "harishsuresh.dev", "custom_domain": true },
    { "pattern": "www.harishsuresh.dev", "custom_domain": true }
  ]
}
